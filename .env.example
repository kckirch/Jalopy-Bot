# Copy this file to src/.env for the current runtime layout.
# Never commit the populated file.

# Discord bot credentials
TOKEN=replace-with-discord-bot-token
CLIENT_ID=replace-with-discord-application-id
GUILD_ID=replace-with-discord-guild-id
ADMIN_ROLE_NAMES=Admin

# Runtime database
# Prefer an absolute path outside the Git checkout in production.
VEHICLE_DB_PATH=/absolute/path/to/vehicleInventory.db

# Scraping
SCRAPER_ENGINE=http
SCRAPER_HTTP_DEBUG=false
SCRAPE_LOG_MODE=summary
# Optional for explicit Selenium mode; use an externally managed executable.
CHROMEDRIVER_PATH=

# Scheduling
SCHEDULER_TIMEZONE=Etc/GMT+7

# Inventory API
INVENTORY_API_HOST=0.0.0.0
INVENTORY_API_PORT=8787
INVENTORY_API_KEY=replace-with-a-long-random-token
INVENTORY_API_ALLOWED_ORIGINS=https://jalopybot.com,https://www.jalopybot.com
INVENTORY_DB_CACHE_SECONDS=3600

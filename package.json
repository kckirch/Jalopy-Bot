{
  "name": "jalopy-bot",
  "version": "1.0.0",
  "description": "Discord bot and inventory API for Idaho salvage-yard vehicle alerts.",
  "private": true,
  "main": "src/bot/discordBotMain.js",
  "scripts": {
    "start": "node src/bot/discordBotMain.js",
    "register:commands": "node src/bot/register-commands.js",
    "start:prod": "npm run register:commands && npm start",
    "start:inventory-api": "node src/api/inventoryApiServer.js",
    "test": "node scripts/run-tests.js",
    "test:coverage": "node scripts/run-tests.js --coverage",
    "smoke:live": "node src/testing/liveScrapeSmokeTest.js",
    "scan:model-aliases": "node src/testing/modelAliasScan.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kckirch/Jalopy-Bot.git"
  },
  "bugs": {
    "url": "https://github.com/kckirch/Jalopy-Bot/issues"
  },
  "homepage": "https://jalopybot.com",
  "keywords": [
    "discord-bot",
    "inventory",
    "nodejs",
    "sqlite",
    "web-scraping"
  ],
  "author": "KC Kircher",
  "license": "ISC",
  "engines": {
    "node": ">=20.10.0 <25"
  },
  "dependencies": {
    "axios": "^1.13.2",
    "cheerio": "^1.1.2",
    "discord.js": "^14.14.1",
    "dotenv": "^16.3.1",
    "node-cron": "^3.0.3",
    "selenium-webdriver": "^4.16.0",
    "simple-git": "^3.27.0",
    "sqlite3": "^5.1.7"
  },
  "optionalDependencies": {
    "chromedriver": "^98.0.1"
  }
}
